# F_PE_constraints.tcl

# clock
create_clock -period 3.8 -name clk [get_ports clk]
set_clock_uncertainty -setup 0.1 [get_clocks clk]
set_clock_transition -rise -max 0.1 [get_clocks clk]
set_clock_transition -fail -max 0.1 [get_clocks clk]

# input delay
set_input_delay 0.1 -clock clk [get_ports {a[*] b[*] s_a s_b bitwidth[*]}]

# output delay
set_output_delay 0.1 -clock clk [get_ports result]  

group_path -name INPUTS -from [all_inputs]
group_path -name OUTPUTS -to [all_outputs]
group_path -name BITBRICK -through [get_cells bb*]

write_sdc -version 2.0 -nosplit F_PE_constraints.sdc



